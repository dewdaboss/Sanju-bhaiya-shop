# Copy to .env for local development. Never commit the real .env file.
PORT=3000

# REQUIRED ON VERCEL: pooled Postgres connection string (Neon/Supabase/etc.).
# Use the provider's pooled endpoint and keep SSL enabled.
DATABASE_URL=

# Set a unique password of at least 12 characters before using the owner dashboard.
ADMIN_PASSWORD=

# Confirmed shop number, international format without + or spaces.
SHOP_WHATSAPP=917970000601

# Local-only fallback when DATABASE_URL is empty: persistent SQLite directory.
# Do not rely on this for Vercel/serverless hosting.
DATA_DIR=./data
